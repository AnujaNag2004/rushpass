# ---- Required ----
NODE_ENV=development
PORT=4000
# Local: docker compose up -d postgres redis   |   Prod: your Neon connection string
DATABASE_URL=postgresql://rushpass:rushpass@localhost:5432/rushpass
# Local: redis://localhost:6379   |   Prod: Upstash URL (starts with rediss://)
REDIS_URL=redis://localhost:6379
# The frontend origin(s), comma-separated. Used for CORS and email links.
CLIENT_URL=http://localhost:5173

# ---- Secrets (required in production; generate with: openssl rand -hex 32) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TICKET_QR_SECRET=
ADMISSION_SECRET=

# ---- Payments (optional) ----
# Leave empty to use the built-in MOCK gateway. Use Razorpay TEST keys only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (optional) ----
# Leave SMTP_HOST empty to use a free Ethereal test inbox (preview links are logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RushPass <tickets@rushpass.dev>

# ---- Tuning ----
# Requests per minute per IP. Raise this when running the k6 load test from one machine.
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
LOG_LEVEL=info
