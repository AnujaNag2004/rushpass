# Leave empty in local development: Vite proxies /api and /socket.io to http://localhost:4000.
# In production set both to your API's public URL, e.g. https://rushpass-api.onrender.com
VITE_API_URL=
VITE_SOCKET_URL=
# Only needed when the API uses Razorpay (same TEST key id as the API's RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=
